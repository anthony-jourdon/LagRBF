#
#  Default architecture neutral makefile for pTatin
#    Operating system: OSX operating system
#    Compiler: gcc,gfortran

# ----------------------------------------------------------------------------
#  Specific compilation flags can be defined using LAG_CFLAGS
#  By default, pTatin will use the CFLAGS associated with your PETSc build
#  LAG_CFLAGS allows you to define a set of compilation flags for pTatin
#  which are independent of those defined by PETSc
#  For example, this enables you to:
#  (i)  Build pTatin with debug symbols (-O0 -g) but link
#       against an optimised PETSc build
#  (ii) Build pTatin with AVX256 and OpenMP support, but link
#       against a PETSc build which does not use AVX or OpenMP
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Definition of LAG_CFLAGS (user to edit)
# ----------------------------------------------------------------------------
# Default
#export LAG_CFLAGS = -O2 -Wall -fstrict-aliasing -funroll-loops #-std=gnu99
# <example> Enforce debug build (independent of petsc configuration)
#export LAG_CFLAGS	= -O0 -Wall -g #-std=gnu99
export LAG_CFLAGS	= -O3 -Wall -Ofast -ftree-vectorize -ftree-vectorizer-verbose=4 -fstrict-aliasing -funroll-loops -mavx #-std=gnu99 

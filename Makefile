# ==============================================================================
#   Makefile for lagrangian-offline
# ==============================================================================

.SECONDEXPANSION:           # To expand $$(@D)/.DIR
.SUFFIXES:                  # Clear .SUFFIXES because we don't use implicit rules
.DELETE_ON_ERROR:           # Delete likely-corrupt target file if rule fails

# PETSc variables (assumes PETSC_DIR and PETSC_ARCH are set in your environment)
include ${PETSC_DIR}/${PETSC_ARCH}/lib/petsc/conf/petscvariables

all : info liblagrbf tests drivers save_config

# Compilation options are to be placed in makefile.arch;
# if that (untracked) file does not exist, defaults are copied there
makefile.arch:
	-@echo "[lagrangian-offline config] using config/makefile.arch.default as makefile.arch"
	-@cp config/makefile.arch.default $@
-include makefile.arch

HAVE_AVX512 := $(shell grep -q 'avx512f' /proc/cpuinfo && echo 1 || echo 0)
HAVE_AVX256 := $(shell grep -q 'avx2\|avx' /proc/cpuinfo && echo 1 || echo 0)
AVX_INFO_MSG :=
ifeq ($(HAVE_AVX512),1)
  LAG_CFLAGS += -mavx512f
  AVX_INFO_MSG += "AVX-512 detected - optimized kernels will be compiled."
else ifeq ($(HAVE_AVX256),1)
  LAG_CFLAGS += -mavx
  AVX_INFO_MSG += "AVX-256 detected - optimized kernels will be compiled."
else
  LAG_CFLAGS += 
	AVX_INFO_MSG += "AVX not detected - scalar kernels will be compiled."
endif
# installation is into a local directory named $(PETSC_ARCH), or for prefix
#  installs when this value is empy, directly into the local directory.
#  Note that this implies that you cannot have two different prefix builds
#  in the same directory.
INSTALL_DIR = $(PWD)/$(PETSC_ARCH)

# Save makefile.arch for reproducibility
MAKEFILE_ARCH_SAVE_LOC=$(INSTALL_DIR)/makefile.arch.log
save_config: $(INSTALL_DIR)/.DIR makefile.arch
	@echo '############################################'    > $(MAKEFILE_ARCH_SAVE_LOC)
	@echo '# DO NOT EDIT THIS FILE - it is just a log #'   >> $(MAKEFILE_ARCH_SAVE_LOC)
	@echo '# To change your configuration, edit       #'   >> $(MAKEFILE_ARCH_SAVE_LOC)
	@echo '# makefile.arch, which will automatically  #'   >> $(MAKEFILE_ARCH_SAVE_LOC)
	@echo '# be copied here                           #'   >> $(MAKEFILE_ARCH_SAVE_LOC)
	@echo '############################################\n' >> $(MAKEFILE_ARCH_SAVE_LOC)
	@cat makefile.arch >> $(MAKEFILE_ARCH_SAVE_LOC)
.PHONY : save_config


OBJDIR ?= $(INSTALL_DIR)/obj
LIBDIR ?= $(INSTALL_DIR)/lib
BINDIR ?= $(INSTALL_DIR)/bin

# Populate includes, libraries, and compiler flags
LAG_INC := $(PETSC_CC_INCLUDES) -I$(PWD)/include

# Include local.mk files from subdirectories
# Directory that contains most recently-parsed makefile (current)
thisdir = $(addprefix $(dir $(lastword $(MAKEFILE_LIST))),$(1))
incsubdirs = $(addsuffix /local.mk,$(call thisdir,$(1)))

liblagrbf-offline-y.c      :=
lagrangian-offline-tests-y.c   :=
lagrangian-offline-drivers-y.c :=

# Prepend directory to sources
#lagrangian-offline-y.c       := $(addprefix src/, $(lagrangian-offline-y.c))
#lagrangian-offline-tests-y.c := $(addprefix src/tests/, $(lagrangian-offline-tests-y.c))

# Recursively include files for all targets
include local.mk

#### Rules ####
ifeq ($(V),)
  quiet_HELP := "Use \"$(MAKE) V=1\" to see the verbose compile lines.\n"
  quiet = @printf $(quiet_HELP)$(eval quiet_HELP:=)"  %10s %s\n" "$1$2" "$@"; $($1)
else ifeq ($(V),0) # Same, but do not print any help
  quiet = @printf "  %10s %s\n" "$1$2" "$@"; $($1)
else # Show the full command line
  quiet = $($1)
endif

.PHONY: liblagrbf liblagrbf-static liblagrbf-shared tests drivers

liblagrbf-static = $(LIBDIR)/liblagrbf.$(AR_LIB_SUFFIX)
liblagrbf-shared = $(LIBDIR)/liblagrbf.so
liblagrbf : $(liblagrbf-static) $(liblagrbf-shared)
$(liblagrbf-static) : $(liblagrbf-offline-y.c:%.c=$(OBJDIR)/%.o)
$(liblagrbf-shared) : $(liblagrbf-offline-y.c:%.c=$(OBJDIR)/%.o) 

info:
	-@echo "—————————————————————————————————————————————————————————————————"
	-@echo " lagrangian-offline"
	-@echo "    git url: https://notyetset.git"
	-@echo "—————————————————————————————————————————————————————————————————"
	-@echo $(AVX_INFO_MSG) 
	-@echo "—————————————————————————————————————————————————————————————————"


%.$(AR_LIB_SUFFIX) : | $$(@D)/.DIR
	$(call quiet,AR) $(AR_FLAGS) $@ $^
	$(call quiet,RANLIB) $@

%.so : | $$(@D)/.DIR
	$(call quiet,$(cc_name)) -shared -o $@ $^ $(PETSC_SNES_LIB)

# Set the compiler
ifeq ($(PETSC_LANGUAGE),CXXONLY)
  cc_name := CXX
else
  cc_name := CC
endif

# GNU extensions flag
LAG_CFLAGS_EXTENSIONS+=-D_GNU_SOURCE
# Position-independent code flag for shared libraries
LAG_CFLAGS_PIC+=-fPIC
# Compiler command for compiling C files, includes the makefile.arch flags
LAG_COMPILE.c = $(call quiet,$(cc_name)) -c $(PCC_FLAGS) $(CCPPFLAGS) $(LAG_CFLAGS) $(LAG_CFLAGS_PIC) $(LAG_INC) $(CFLAGS) $(C_DEPFLAGS) $(LAG_CFLAGS_EXTENSIONS)

# Test executables
tests: $(lagrangian-offline-tests-y.c:%.c=$(BINDIR)/%.app)
$(lagrangian-offline-tests-y.c:%.c=$(BINDIR)/%.app) : $(liblagrbf-static)
.SECONDARY: $(lagrangian-offline-tests-y.c:%.c=$(OBJDIR)/%.o)

# Drivers
drivers: $(lagrangian-offline-drivers-y.c:%.c=$(BINDIR)/%.app)
$(lagrangian-offline-drivers-y.c:%.c=$(BINDIR)/%.app) : $(liblagrbf-static)
.SECONDARY: $(lagrangian-offline-drivers-y.c:%.c=$(OBJDIR)/%.o)

$(BINDIR)/%.app : $(OBJDIR)/%.o | $$(@D)/.DIR
	$(call quiet,PCC_LINKER) $(LAG_CFLAGS) -o $@ $^ $(PETSC_SNES_LIB) $(LAG_LIB)
	@ln -sf $(abspath $@) $(BINDIR)

$(OBJDIR)/%.o: %.c | $$(@D)/.DIR
	$(LAG_COMPILE.c) $(abspath $<) -o $@

# Ensure the directories exist
%/.DIR :
	@mkdir -p $(@D)
	@touch $@

.PRECIOUS: %/.DIR

.PHONY: clean all print

clean:
	rm -rf $(OBJDIR) $(LIBDIR) $(BINDIR)

print:
	@echo $($(VAR))

srcs.c := $(liblagrbf-offline-y.c) $(lagrangian-offline-tests-y.c) $(lagrangian-offline-drivers-y.c)
srcs.o := $(srcs.c:%.c=$(OBJDIR)/%.o)
srcs.d := $(srcs.o:%.o=%.d)
# Tell make that srcs.d are all up to date.  Without this, the include
# below has quadratic complexity, taking more than one second for a
# do-nothing build of PETSc (much worse for larger projects)
$(srcs.d) : ;

-include $(srcs.d)
